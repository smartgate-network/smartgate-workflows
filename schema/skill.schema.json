{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://smartgate.network/schemas/skill.schema.json",
  "title": "SmartGate Workflow Skill",
  "type": "object",
  "required": [
    "name",
    "purpose",
    "when_to_use",
    "when_not_to_use",
    "returns",
    "composes_with"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 10
    },
    "when_to_use": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "when_not_to_use": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "returns": {
      "type": "string",
      "minLength": 10
    },
    "composes_with": {
      "type": "string",
      "minLength": 5
    }
  }
}
